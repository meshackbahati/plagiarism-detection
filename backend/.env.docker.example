# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/plagiarism_db

# Security
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Seeded admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
CREATE_SAMPLE_USERS=false

# Storage
# Set to `s3` for MinIO/S3 or `local` for local filesystem.
STORAGE_TYPE=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=plagiarism-uploads

# AI Detection
USE_EXTERNAL_AI_DETECTION=false
OPENAI_API_KEY=
TOGETHER_API_KEY=

# Resource Management
# Set to 'true' to skip loading local ML models (~580MB saved).
# In lightweight mode, only statistical heuristics run locally;
# set OPENAI_API_KEY or TOGETHER_API_KEY for ML-based AI detection.
LIGHTWEIGHT_MODE=false
# Seconds of inactivity before models are auto-unloaded from memory (0 = disabled)
MODEL_UNLOAD_TIMEOUT=300
# Max documents to search in cross-batch plagiarism detection
MAX_CROSS_BATCH_DOCS=500

# Celery & Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Environment
ENVIRONMENT=production

# Upload and extraction limits
MAX_UPLOAD_BYTES=209715200
MAX_FILES_PER_BATCH=500
MAX_PDF_PAGES=1000
MAX_OCR_PAGES=100
OCR_LANG=eng

# Plagiarism tuning (see docs/plagiarism.md#tuning)
SHINGLE_SIZE=5
MIN_MATCH_WORDS=8
SEMANTIC_MATCH_THRESHOLD=0.82
MIN_REPORTED_SIMILARITY=0.05
CROSS_BATCH_CANDIDATES=20
# user = compare only against the same account's uploads; all = shared corpus
# (other accounts' names and text are hidden in results)
CROSS_BATCH_SCOPE=user
